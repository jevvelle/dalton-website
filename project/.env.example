# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit your actual ESP32-CAM IP, credentials,
# or any other real configuration.

# ---- Dalton's ESP32-CAM ----
# Find this by checking your router's connected-devices list, or by reading
# the IP the ESP32-CAM prints over Serial when it boots. Port 81 and the
# /stream path are the ESP32-CAM example firmware's defaults.
ESP32_STREAM_URL=http://YOUR_ESP32_IP:81/stream

# Seconds to wait between reconnect attempts if the stream drops.
RECONNECT_DELAY=2.0

# ---- Flask server ----
HOST=0.0.0.0
PORT=5000
DEBUG=False

# ---- Streaming / performance tuning ----
MAX_STREAM_WIDTH=640
JPEG_QUALITY=80
FRAME_INTERVAL=0.03

# ---- Color isolation tuning ----
SATURATION_BOOST=1.6
MASK_DILATE_ITERATIONS=1

# ---- Future: Dalton robot control channel ----
ROBOT_CONTROL_URL=
